# Ignore all local caches, logs, and installation binaries
tmp/
.venvs/
antigravity-backup/
antigravity-browser-profile/
antigravity-cli/
antigravity-ide/
antigravity/
config/
history/
projects.json
settings.json
*.log
brain/
conversations/

# Ignore sensitive credentials
google_accounts.json
oauth_creds.json

# Ignore local secrets and private keys
.env
.env.*
*.pem
*.key
*.p12
*.pkcs12
*.json.key
secrets/

# Ignore Python compilation artifacts and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Ignore autogenerated skill references and auto-bundled Data Cloud skills
skills/*/references/
skills/.datacloud_skills_manifest
skills/accidental-data-loss-prevention/
skills/bigquery/
skills/bigquery-data-transfer-service/
skills/building-data-apps/
skills/data-autocleaning/
skills/dataform-bigquery/
skills/dbt-bigquery/
skills/discovering-gcp-data-assets/
skills/federate-lakehouse-catalog/
skills/gcloud-auth-verification/
skills/gcp-composer-troubleshooting/
skills/gcp-data-pipelines/
skills/gcp-dataflow/
skills/gcp-managed-airflow-migrations/
skills/gcp-pipeline-orchestration/
skills/gcp-pipeline-resource-provisioning/
skills/gcp-spark/
skills/gcs-security-assessment/
skills/managing-python-dependencies/
skills/ml-best-practices/
skills/notebook-guidance/
skills/skill-repair/

# Ignore custom artifacts folder for planner and timelines
artifacts/
*.egg-info/

scratch/
